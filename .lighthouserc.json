{
  "ci": {
    "collect": {
      "numberOfRuns": 1,
      "startServerCommand": "http-server . -p 8080 -c-1",
      "startServerReadyPattern": "Available on",
      "url": [
        "http://127.0.0.1:8080/",
        "http://127.0.0.1:8080/app-testers.html"
      ],
      "settings": {
        "chromeFlags": "--no-sandbox --disable-dev-shm-usage"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.75
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 0.9
          }
        ]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
